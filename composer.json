{
	"name": "elielelie/laravel-activemq",
    "description": "Laravel ActiveMQ driver",
    "keywords": [
        "php",
        "laravel",
        "driver",
        "stomp",
		"ActiveMQ",
        "queue"
    ],
	"license": "MIT",
    "require": {
        "php": "^8.0",
        "illuminate/queue": "^9.0|^10.0|^11.0|^12.0|^13.0",
        "illuminate/support": "^9.0|^10.0|^11.0|^12.0|^13.0",
        "stomp-php/stomp-php": "^5.0"
    },
	"autoload": {
        "psr-4": {
            "Elielelie\\ActiveMQ\\": "src/"
        }
    },
	"autoload-dev": {
        "psr-4": {
            "Elielelie\\ActiveMQ\\Tests\\": "tests/"
        }
    },
	"extra": {
        "laravel": {
            "providers": [
                "Elielelie\\ActiveMQ\\ActiveMQServiceProvider"
            ],
            "aliases": [
                {
                    "alias": "ActiveMQ",
                    "facade": "Elielelie\\ActiveMQ\\Facades\\ActiveMQ"
                }
            ]
        }
    },
	"require-dev": {
		"pestphp/pest": "^2.34|^3.8|^4.0",
		"pestphp/pest-plugin-laravel": "^2.0|^3.2|^4.0",
		"orchestra/testbench": "^8.0|^9.0|^10.11|^11.0",
		"laravel/pint": "^1.29"
	},
	"config": {
		"allow-plugins": {
			"pestphp/pest-plugin": true
		}
	}
}
